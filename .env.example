# Reference copy of every service's environment. Each service reads its OWN
# .env file (services/<name>/.env) — this root file documents the whole set.
#
# The gateway is the only component that talks to all three, and it holds no
# secrets of its own.

# --- Gateway (integration layer) ---
# Copy to services/gateway/.env. See services/gateway/.env.example for the
# full set of tunables (timeouts, multi-question policy, job TTL).
GATEWAY_PORT=8080
GATEWAY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OCR_SERVICE_URL=http://127.0.0.1:8000
REASONING_SERVICE_URL=http://127.0.0.1:8002
FEEDBACK_SERVICE_URL=http://127.0.0.1:8003

# --- OCR Service (Module 01) ---
# NOTE: this service listens on 8000 (its Dockerfile and SYSTEM_RUN_GUIDE.md
# both use `uvicorn app:app` with no port override). An earlier version of this
# file said 8001, which was never true of the code.
OCR_PORT=8000
OPENAI_API_KEY=your_openai_key_here
OPENAI_VISION_MODEL=gpt-5.6

# --- Reasoning Service (Module 02) ---
# This service raises at IMPORT time without OPENAI_API_KEY — it will not start
# at all if the key is missing.
REASONING_PORT=8002
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# --- Feedback Service (Module 03) ---
# Serving goes through a persistent Hugging Face Space (Gradio SDK). The code
# reads SPACE_ID, not a full URL — see
# services/feedback-service/app/serving/hf_space/DEPLOY.md.
FEEDBACK_PORT=8003
SPACE_ID=DhanushkaGodage/feedback-service-inference
API_KEY=your_shared_space_api_key_here
HF_TOKEN=your_huggingface_token_here

# --- Frontend ---
# Leave blank to use the Vite dev proxy (vite.config.ts forwards /api to :8080).
VITE_GATEWAY_URL=

# Training-only (used by app/training/train.py inside Colab/Kaggle, not by
# the deployed service)
LORA_ADAPTER_DIR=./lora-adapter
WANDB_PROJECT=handwritten-algebra-evaluator
WANDB_RUN_NAME=qwen25-3b-feedback-lora

        "step_id": 7,
        "content": "= [(x-2)(x-3)(x+3)] / [(x-3)(x+2)]"
      },
      {
        "step_id": 8,
        "content": "Cancel (x-3): = (x-2)(x+3) / (x+2)"
      },
      {
        "step_id": 9,
        "content": "= (x²+x-6) / (x+2)"
      }
    ],
    "final_answer": "(x-2)(x+3)/(x+2) or (x²+x-6)/(x+2)"

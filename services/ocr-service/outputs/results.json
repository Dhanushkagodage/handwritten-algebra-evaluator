    "result": {
      "reasoning_input": {
        "question_text": "Solve 2x^2 + 3x - 2 = 0. Solve 2x + y = 7 and x - y = 2; find x and y values.",
        "student_steps": [
          {
            "step_id": 1,
            "content": "Using quadratic formula: a = 2, b = 3, c = -2"
          },
          {
            "step_id": 2,
            "content": "x = (-3 ± sqrt((3)^2 - 4(2)(-2)))/(2(2))"
          },
          {
            "step_id": 3,
            "content": "x = (-3 ± sqrt(9 - 16))/4"
          },
          {
            "step_id": 4,
            "content": "x = (-3 ± sqrt(-7))/4"
          },
          {
            "step_id": 5,
            "content": "2x + y = 7"
          },
          {
            "step_id": 6,
            "content": "x - y = 2"
          },
          {
            "step_id": 7,
            "content": "Add both equations"
          },
          {
            "step_id": 8,
            "content": "3x = 9"
          },
          {
            "step_id": 9,
            "content": "x = 3"
          }
        ],
        "final_answer": "x = 3"
      }
    }
  },
  {

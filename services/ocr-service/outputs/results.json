    "result": {
      "reasoning_input": {
        "question_text": "Resolve partial fractions: (3x^2 + 5x + 4)/((x - 1)(x^2 + 1))",
        "student_steps": [
          {
            "step_id": 1,
            "content": "Let (3x^2 + 5x + 4)/((x - 1)(x^2 + 1)) = A/(x - 1) + (Bx + C)/(x^2 + 1)"
          },
          {
            "step_id": 2,
            "content": "3x^2 + 5x + 4 = A(x^2 + 1) + (Bx + C)(x - 1)"
          },
          {
            "step_id": 3,
            "content": "Expanding: 3x^2 + 5x + 4 = (A + B)x^2 + (C - B)x + (A - C)"
          },
          {
            "step_id": 4,
            "content": "Equating coefficients: A + B = 3, C - B = 5, A - C = 4"
          },
          {
            "step_id": 5,
            "content": "A = 6, B = -3, C = 2"
          },
          {
            "step_id": 6,
            "content": "Therefore 6/(x - 1) + (-3x + 2)/(x^2 + 1)"
          }
        ],
        "final_answer": "6/(x - 1) + (-3x + 2)/(x^2 + 1)"
      }
    }
  },

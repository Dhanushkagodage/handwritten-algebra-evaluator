# Public URL of your Colab-trained model's /generate endpoint (see
# app/training/COLAB.md — start colab_server.py + cloudflared, paste the
# printed https://...trycloudflare.com URL here with /generate appended).
# Changes every time that Colab session restarts.
TUNNEL_API_URL=https://your-tunnel-subdomain.trycloudflare.com/generate

# ── Training-only settings (used by app/training/train.py and colab_server.py
#    when run inside Colab/Kaggle — not read by the deployed service) ──
LOCAL_BASE_MODEL=Qwen/Qwen2.5-3B-Instruct
LORA_ADAPTER_DIR=./lora-adapter
DATASET_PATH=app/training/data/feedback_dataset_train.json
EVAL_DATASET_PATH=app/training/data/feedback_dataset_eval.json
OUTPUT_DIR=./lora-adapter
WANDB_PROJECT=handwritten-algebra-evaluator
WANDB_RUN_NAME=qwen25-3b-feedback-lora

PORT=8003

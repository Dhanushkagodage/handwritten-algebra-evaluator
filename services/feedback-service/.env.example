# Hugging Face Space serving the fine-tuned model (see
# app/serving/hf_space/DEPLOY.md for the one-time setup), and the shared
# secret it expects as the generate() api_key argument.
SPACE_ID=DhanushkaGodage/feedback-service-inference
API_KEY=your_shared_space_api_key_here

# ── Training-only settings (used by app/training/train.py when run inside
#    Colab/Kaggle — not read by the deployed service). ──
LORA_ADAPTER_DIR=./lora-adapter
DATASET_PATH=app/training/data/feedback_dataset_train.json
EVAL_DATASET_PATH=app/training/data/feedback_dataset_eval.json
OUTPUT_DIR=./lora-adapter
WANDB_PROJECT=handwritten-algebra-evaluator
WANDB_RUN_NAME=qwen25-3b-feedback-lora

PORT=8003

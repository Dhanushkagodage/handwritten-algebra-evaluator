# ─────────────────────────────────────────────────────────────────────────────
# Gateway (integration layer) configuration
#
# The gateway holds NO secrets. It never talks to OpenAI or Hugging Face — it
# only calls the three module services, which own their own credentials.
# ─────────────────────────────────────────────────────────────────────────────

GATEWAY_PORT=8080
GATEWAY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Use 127.0.0.1 rather than localhost: on Windows `localhost` resolves to ::1
# first, and a uvicorn bound to 127.0.0.1 will refuse that connection.
#
# NOTE: ocr-service listens on 8000 (see its Dockerfile and SYSTEM_RUN_GUIDE.md),
# NOT 8001 as the repo-root .env.example incorrectly states.
OCR_SERVICE_URL=http://127.0.0.1:8000
REASONING_SERVICE_URL=http://127.0.0.1:8002
FEEDBACK_SERVICE_URL=http://127.0.0.1:8003

# Per-stage read timeouts (seconds).
# FEEDBACK_TIMEOUT_S must stay above feedback-service's own retry ladder
# (0 + 5 + 15 + 30s of sleeps plus four Space calls) or the gateway will 504
# while the downstream request is still succeeding.
CONNECT_TIMEOUT_S=5
OCR_TIMEOUT_S=180
OCR_SCHEME_TIMEOUT_S=120
REASONING_TIMEOUT_S=240
FEEDBACK_TIMEOUT_S=300

# OCR defaults forwarded to ocr-service.
DEFAULT_OCR_MODE=openai_vision
DEFAULT_USE_MATH_OCR=false

# One uploaded marking scheme cannot correctly grade several questions, so when
# OCR reports more than one question we grade the first and attach a warning.
#   first | all | error
MULTI_QUESTION_POLICY=first

# Keep OCR steps that the reasoning service never analysed, so student work is
# never silently dropped from the results page.
INCLUDE_UNANALYZED_STEPS=true

MAX_ANSWER_IMAGES=5
MAX_UPLOAD_MB=10

# The job store is in-process. Run the gateway with a SINGLE worker
# (uvicorn's default) — with two workers, a job created on worker A 404s on
# worker B. `--reload` also wipes the store on every file save.
JOB_TTL_SECONDS=1800
JOB_MAX_CONCURRENCY=2
MAX_JOBS=200

LOG_LEVEL=INFO
